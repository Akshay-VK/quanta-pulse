{
  "name": "quanta-pulse",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Minimal native desktop tracker for BITS Pilani Quanta LMS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app && bash scripts/make-dmg.sh",
    "app:build:mac": "tauri build --bundles app && bash scripts/make-dmg.sh",
    "app:build:mac:dmg": "bash scripts/make-dmg.sh",
    "app:build:win": "tauri build --bundles nsis",
    "icon": "tauri icon",
    "version:check": "node scripts/version-check.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "release": "node scripts/release.mjs",
    "release:config:check": "node scripts/check-release-config.mjs",
    "preversion": "node scripts/version-check.mjs",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "3.14.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "cmdk": "1.1.1",
    "lucide-react": "1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinykeys": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.14.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vitest-axe": "0.1.0"
  }
}
