{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Quanta Pulse main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:app:default",
    "notification:default",
    "opener:default",
    "opener:allow-open-url",
    "dialog:default",
    "autostart:default",
    "updater:default",
    "process:default"
  ]
}
